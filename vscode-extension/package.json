{
  "name": "ai-usage-widget-copilot",
  "displayName": "AI Usage Widget — Copilot Connection",
  "description": "Share Copilot usage with your local floating AI Usage Widget using your approved VS Code GitHub sign-in.",
  "version": "1.15.0",
  "publisher": "wernerong",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/wernerong/ai-usage-widget", "directory": "vscode-extension" },
  "engines": { "vscode": "^1.120.0" },
  "categories": ["Other"],
  "extensionKind": ["ui"],
  "main": "./extension.js",
  "activationEvents": ["onStartupFinished", "onUri"],
  "capabilities": { "untrustedWorkspaces": { "supported": true }, "virtualWorkspaces": { "supported": false } },
  "contributes": {
    "commands": [
      { "command": "aiUsageWidget.connectCopilot", "title": "AI Usage Widget: Connect Copilot Account" },
      { "command": "aiUsageWidget.refreshCopilot", "title": "AI Usage Widget: Refresh Copilot Usage" },
      { "command": "aiUsageWidget.disconnectCopilot", "title": "AI Usage Widget: Disconnect Copilot Account" }
    ]
  },
  "scripts": { "test": "node --test tests/*.test.js", "package": "vsce package --no-dependencies --out ../dist/AIUsageWidget-Copilot-VSCode.vsix" },
  "devDependencies": { "@vscode/vsce": "4.0.0" }
}
