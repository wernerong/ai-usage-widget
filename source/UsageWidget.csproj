<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>AIUsageWidget</AssemblyName>
    <Version>1.7.0</Version>
    <UseAppHost>true</UseAppHost>
    <ApplicationIcon>Assets/widget.ico</ApplicationIcon>
    <RuntimeIdentifiers>win-x64;osx-arm64;osx-x64</RuntimeIdentifiers>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.22" />
    <AvaloniaResource Include="Assets/*.png" />
    <InternalsVisibleTo Include="UsageWidget.UiChecks" />
  </ItemGroup>
</Project>
